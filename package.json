{
  "name": "stagehand",
  "displayName": "Stagehand",
  "description": "Git history viewer inspired by JetBrains Rider's git log",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "stagehand",
          "title": "Stagehand",
          "icon": "$(git-commit)"
        }
      ]
    },
    "views": {
      "stagehand": [
        {
          "type": "webview",
          "id": "stagehand.history",
          "name": "History"
        }
      ]
    },
    "commands": [
      {
        "command": "stagehand.showCurrentBranch",
        "title": "Stagehand: Show Current Branch"
      },
      {
        "command": "stagehand.history.loadCommits",
        "title": "Stagehand: Load Commits"
      },
      {
        "command": "stagehand.history.commitDetails",
        "title": "Stagehand: Commit Details"
      },
      {
        "command": "stagehand.history.branchesContaining",
        "title": "Stagehand: Branches Containing Commit"
      },
      {
        "command": "stagehand.history.changedFiles",
        "title": "Stagehand: Changed Files"
      },
      {
        "command": "stagehand.history.openDiff",
        "title": "Stagehand: Open Diff"
      },
      {
        "command": "stagehand.history.checkout",
        "title": "Stagehand: Checkout Commit"
      },
      {
        "command": "stagehand.copyRevision",
        "title": "Stagehand: Copy Revision Number"
      },
      {
        "command": "stagehand.compareWithLocal",
        "title": "Stagehand: Compare with Local"
      },
      {
        "command": "stagehand.editMessage",
        "title": "Stagehand: Edit Commit Message"
      },
      {
        "command": "stagehand.newBranch",
        "title": "Stagehand: New Branch"
      },
      {
        "command": "stagehand.newTag",
        "title": "Stagehand: New Tag"
      },
      {
        "command": "stagehand.history.askRefName",
        "title": "Stagehand: Ask for a Branch/Tag Name"
      },
      {
        "command": "stagehand.revert",
        "title": "Stagehand: Revert Commits"
      },
      {
        "command": "stagehand.cherryPick",
        "title": "Stagehand: Cherry-Pick Commits"
      },
      {
        "command": "stagehand.sequencerContinue",
        "title": "Stagehand: Continue Revert/Cherry-Pick"
      },
      {
        "command": "stagehand.sequencerAbort",
        "title": "Stagehand: Abort Revert/Cherry-Pick"
      },
      {
        "command": "stagehand.history.sequencerState",
        "title": "Stagehand: Revert/Cherry-Pick State"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . && npm run build:webview",
    "build:webview": "esbuild src/webview/main.ts --bundle --format=iife --outdir=out/webview && cp src/webview/index.html out/webview/",
    "lint": "eslint src",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "test:unit": "vitest run --dir src/core",
    "test:webview": "npm run build:webview && playwright test",
    "test:integration": "npm run compile && vscode-test",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run test:webview && npm run test:integration"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.11",
    "@types/vscode": "~1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  }
}
